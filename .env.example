# AI Analyst — copy to .env and fill in at least one key.
# Keep comments on their own lines: docker compose treats an inline "# ..." after an
# empty value as the value itself.

# Gemini API key (free tier works)
GEMINI_API_KEY=

# Anthropic API key (optional; used by default when set)
ANTHROPIC_API_KEY=

# Optional model override (default gemini-3.8-flash)
GEMINI_MODEL=

# Optional model override (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Optional: force a provider — gemini | anthropic | mock (only used if its key is set)
AI_PROVIDER=
